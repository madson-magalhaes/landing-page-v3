# Meta Pixel (PUBLIC)
NEXT_PUBLIC_META_PIXEL_ID=YOUR_PIXEL_ID_HERE

# Supabase (PUBLIC - anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Schema (cliente específico)
NEXT_PUBLIC_SCHEMA_ID=schema_v3

# WhatsApp
# Use {cupom} como placeholder para o ref_id (identificador único da sessão para tracking)
NEXT_PUBLIC_WHATSAPP_NUMBER=558899XXXXXXX
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá! Quero saber mais. Cupom: {cupom}

# Backend (PRIVATE - nunca exponha ao client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
